    },
    {
      "cell_type": "code",
      "source": [
        "print(\"My First Data Science Project\")\n",
        "print(\"Retail Sales Data Analysis\")\n",
        "\n",
        "product = \"Laptop\"\n",
        "price = 50000\n",
        "quantity_sold = 3\n",
        "\n",
        "total_sales = price * quantity_sold\n",
        "\n",
        "print(\"Product:\", product)\n",
        "print(\"Price:\", price)\n",
        "print(\"Quantity Sold:\", quantity_sold)\n",
        "print(\"Total Sales:\", total_sales)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "MahL2_DoIohy",
        "outputId": "9299a0bc-f9a5-4e51-b5a3-8be6a8bd8ca1"
      },
      "execution_count": 28,
