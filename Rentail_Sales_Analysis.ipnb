    {
      "cell_type": "code",
      "source": [
        "# Calculate each product's percentage of total revenue\n",
        "df[\"Revenue_Percentage\"] = (\n",
        "    df[\"Total_Sales\"] / df[\"Total_Sales\"].sum()\n",
        ") * 100\n",
        "\n",
        "# Display the results\n",
        "print(df[[\"Product\", \"Total_Sales\", \"Revenue_Percentage\"]].round(2))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "UPi_38VwQWvZ",
        "outputId": "12e3034e-0a0b-4580-dfe0-30b87850effc"
      },
      "execution_count": 36,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "      Product  Total_Sales  Revenue_Percentage\n",
            "0      Laptop       150000               61.35\n",
            "1       Mouse        10000                4.09\n",
            "2    Keyboard        12000                4.91\n",
            "3     Monitor        50000               20.45\n",
            "4  Headphones        22500                9.20\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(8, 8))\n",
        "\n",
        "plt.pie(\n",
        "    df[\"Total_Sales\"],\n",
        "    labels=df[\"Product\"],\n",
        "    autopct=\"%1.1f%%\",\n",
        "    startangle=90\n",
        ")\n",
        "\n",
        "plt.title(\"Percentage Contribution to Total Revenue\")\n",
        "plt.show()"
