    {
      "cell_type": "code",
      "source": [
        "# Calculate key sales metrics\n",
        "\n",
        "total_revenue = df[\"Revenue\"].sum()\n",
        "total_units = df[\"Quantity\"].sum()\n",
        "total_transactions = len(df)\n",
        "average_revenue = df[\"Revenue\"].mean()\n",
        "\n",
        "print(\"RETAIL SALES ANALYSIS\")\n",
        "print(\"---------------------\")\n",
        "print(f\"Total Revenue: ₹{total_revenue:,.2f}\")\n",
        "print(f\"Total Units Sold: {total_units}\")\n",
        "print(f\"Total Transactions: {total_transactions}\")\n",
        "print(f\"Average Revenue per Transaction: ₹{average_revenue:,.2f}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "JG-8RUhOSm3z",
        "outputId": "97097d67-b1db-4c27-e162-98ddebe75ea1"
      },
      "execution_count": 47,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "RETAIL SALES ANALYSIS\n",
            "---------------------\n",
            "Total Revenue: ₹202,000.00\n",
            "Total Units Sold: 35\n",
            "Total Transactions: 10\n",
            "Average Revenue per Transaction: ₹20,200.00\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "product_revenue = (\n",
        "    df.groupby(\"Product\")[\"Revenue\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "print(\"Revenue by Product:\")\n",
        "print(product_revenue)\n",
        "\n",
        "print(\"\\nTop Revenue Product:\", product_revenue.idxmax())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
