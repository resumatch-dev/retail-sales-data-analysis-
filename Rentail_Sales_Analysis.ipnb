    {
      "cell_type": "code",
      "source": [
        "# 1. Calculate total revenue\n",
        "total_revenue = df[\"Total_Sales\"].sum()\n",
        "print(\"Total Revenue:\", total_revenue)\n",
        "\n",
        "# 2. Find the product with the highest revenue\n",
        "best_revenue_product = df.loc[df[\"Total_Sales\"].idxmax()]\n",
        "\n",
        "print(\"Highest Revenue Product:\", best_revenue_product[\"Product\"])\n",
        "print(\"Revenue:\", best_revenue_product[\"Total_Sales\"])\n",
        "\n",
        "# 3. Find the product with the most units sold\n",
        "best_selling_product = df.loc[df[\"Quantity_Sold\"].idxmax()]\n",
        "\n",
        "print(\"Most Units Sold:\", best_selling_product[\"Product\"])\n",
        "print(\"Quantity:\", best_selling_product[\"Quantity_Sold\"])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cLn5UycsPg9f",
        "outputId": "52c1d9f6-22b5-4a73-c694-726125194ac3"
      },
      "execution_count": 34,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total Revenue: 244500\n",
            "Highest Revenue Product: Laptop\n",
            "Revenue: 150000\n",
            "Most Units Sold: Mouse\n",
            "Quantity: 20\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.bar(df[\"Product\"], df[\"Total_Sales\"])\n",
        "\n",
        "plt.title(\"Revenue by Product\")\n",
        "plt.xlabel(\"Product\")\n",
        "plt.ylabel(\"Revenue\")\n",
        "\n",
        "plt.xticks(rotation=30)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
