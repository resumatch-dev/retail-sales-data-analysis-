          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Convert Date column to datetime\n",
        "df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n",
        "\n",
        "# Extract the month\n",
        "df[\"Month\"] = df[\"Date\"].dt.month_name()\n",
        "\n",
        "print(df[[\"Date\", \"Product\", \"Revenue\", \"Month\"]].head())\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "x_LIjwzpSI_V",
        "outputId": "5e3d99e6-1eb3-4a14-cc9e-b167d0ee1ee5"
      },
      "execution_count": 44,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "        Date   Product  Revenue    Month\n",
            "0 2026-01-05    Laptop    50000  January\n",
            "1 2026-01-08     Mouse     2500  January\n",
            "2 2026-01-12  Keyboard     2400  January\n",
            "3 2026-01-15   Monitor    10000  January\n",
            "4 2026-01-20     Mouse     4000  January\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "monthly_sales = (\n",
        "    df.groupby(df[\"Date\"].dt.to_period(\"M\"))[\"Revenue\"]\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "print(\"Monthly Sales:\")\n",
        "print(monthly_sales)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "l_bn_95YSOoa",
        "outputId": "753a94b9-5b82-4e7d-eeb1-ab07d3203689"
      },
      "execution_count": 45,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Monthly Sales:\n",
            "Date\n",
            "2026-01     68900\n",
            "2026-02    133100\n",
            "Freq: M, Name: Revenue, dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "monthly_sales.index = monthly_sales.index.astype(str)\n",
        "\n",
        "monthly_sales.plot(kind=\"bar\", figsize=(8, 5))\n",
        "\n",
        "plt.title(\"Monthly Revenue Analysis\")\n",
        "plt.xlabel(\"Month\")\n",
        "plt.ylabel(\"Revenue\")\n",
        "plt.xticks(rotation=0)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 489
