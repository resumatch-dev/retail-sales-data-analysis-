    },
    {
      "cell_type": "code",
      "source": [
        "# Count duplicate rows\n",
        "print(\"Duplicate rows:\", df.duplicated().sum())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "77gY6-i-Rr9C",
        "outputId": "24cc6cf6-18bd-4040-a666-726a665a1ac2"
      },
      "execution_count": 42,
      "outputs": [
        {
          "output_type": "stream",
