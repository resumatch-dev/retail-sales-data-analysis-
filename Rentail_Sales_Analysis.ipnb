    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "data = {\n",
        "    \"Date\": [\n",
        "        \"2026-01-05\",\n",
        "        \"2026-01-08\",\n",
        "        \"2026-01-12\",\n",
        "        \"2026-01-15\",\n",
        "        \"2026-01-20\",\n",
        "        \"2026-02-03\",\n",
        "        \"2026-02-10\",\n",
        "        \"2026-02-15\",\n",
        "        \"2026-02-20\",\n",
        "        \"2026-02-25\"\n",
        "    ],\n",
        "    \"Product\": [\n",
        "        \"Laptop\", \"Mouse\", \"Keyboard\", \"Monitor\", \"Mouse\",\n",
        "        \"Laptop\", \"Headphones\", \"Monitor\", \"Keyboard\", \"Mouse\"\n",
        "    ],\n",
        "    \"Price\": [\n",
        "        50000, 500, 1200, 10000, 500,\n",
        "        50000, 1500, 10000, 1200, 500\n",
        "    ],\n",
        "    \"Quantity\": [\n",
        "        1, 5, 2, 1, 8,\n",
        "        2, 4, 2, 3, 7\n",
        "    ]\n",
        "}\n",
        "\n",
        "sales_df = pd.DataFrame(data)\n",
        "\n",
        "sales_df[\"Revenue\"] = sales_df[\"Price\"] * sales_df[\"Quantity\"]\n",
        "\n",
        "sales_df.to_csv(\"retail_sales.csv\", index=False)\n",
        "\n",
        "print(\"CSV file created successfully!\")\n",
        "sales_df"
      ],
