            "Duplicate rows: 0\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Create a practice copy\n",
        "clean_df = df.copy()\n",
        "\n",
        "# Introduce a missing value\n",
        "clean_df.loc[0, \"Quantity\"] = None\n",
        "\n",
        "# Add a duplicate row\n",
        "clean_df = pd.concat(\n",
        "    [clean_df, clean_df.iloc[[1]]],\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "print(\"Before cleaning:\")\n",
        "print(\"Missing quantities:\", clean_df[\"Quantity\"].isnull().sum())\n",
        "print(\"Duplicate rows:\", clean_df.duplicated().sum())\n",
        "\n",
        "# Remove duplicate rows\n",
        "clean_df = clean_df.drop_duplicates()\n",
        "\n",
        "# Remove rows with missing quantities\n",
        "clean_df = clean_df.dropna(subset=[\"Quantity\"])\n",
        "\n",
        "print(\"\\nAfter cleaning:\")\n",
        "print(\"Missing quantities:\", clean_df[\"Quantity\"].isnull().sum())\n",
        "print(\"Duplicate rows:\", clean_df.duplicated().sum())\n",
        "\n",
        "print(\"\\nCleaned dataset:\")\n",
        "print(clean_df)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cBon9FJ6R0w_",
        "outputId": "b1dbcd39-b545-44b9-dae8-d3dfaad354dc"
      },
      "execution_count": 43,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
