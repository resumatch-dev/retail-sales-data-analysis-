        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "My First Data Science Project\n",
            "Retail Sales Data Analysis\n",
            "Product: Laptop\n",
            "Price: 50000\n",
            "Quantity Sold: 3\n",
            "Total Sales: 150000\n"
          ]
        }
      ]
    },
