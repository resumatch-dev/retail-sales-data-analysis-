      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "data = {\n",
        "    \"Product\": [\"Laptop\", \"Mouse\", \"Keyboard\", \"Monitor\", \"Headphones\"],\n",
        "    \"Price\": [50000, 500, 1200, 10000, 1500],\n",
        "    \"Quantity_Sold\": [3, 20, 10, 5, 15]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "df[\"Total_Sales\"] = df[\"Price\"] * df[\"Quantity_Sold\"]\n",
        "\n",
        "df"
      ],
      "metadata": {
